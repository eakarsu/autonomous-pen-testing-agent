{
  "version": 1,
  "appId": "autonomous-pen-testing-agent",
  "workflows": [
    {
      "id": "alert-ingestion",
      "title": "Security Alert Ingestion",
      "description": "Normalize alerts from a declared local file, manual entry, webhook test, or configured security provider.",
      "fields": [
        {"key": "sourceName", "label": "Source Name", "type": "text", "required": true},
        {"key": "sourceType", "label": "Source Type", "type": "select", "required": true, "options": ["SIEM", "EDR", "Email", "Webhook", "CSV", "Manual"]},
        {"key": "ingestionMode", "label": "Ingestion Mode", "type": "select", "required": true, "options": ["Local fixture", "Manual entry", "Configured connector"]},
        {"key": "payloadReference", "label": "Payload Reference", "type": "text", "required": true},
        {"key": "providerStatus", "label": "Provider Status", "type": "select", "required": true, "options": ["Not required", "Not configured", "Configured"]}
      ],
      "states": ["draft", "testing", "active", "paused", "error"],
      "transitions": [
        {"id": "test", "label": "Test Normalization", "from": ["draft", "error"], "to": "testing"},
        {"id": "activate", "label": "Activate Source", "from": ["testing", "paused"], "to": "active"},
        {"id": "pause", "label": "Pause Source", "from": ["active"], "to": "paused"},
        {"id": "error", "label": "Record Ingestion Error", "from": ["testing", "active"], "to": "error"}
      ],
      "seeds": [{"id": "alert-source-1001", "state": "draft", "sourceName": "SOC sample alerts", "sourceType": "CSV", "ingestionMode": "Local fixture", "payloadReference": "fixtures/alerts-july.csv", "providerStatus": "Not required"}]
    },
    {
      "id": "ai-triage",
      "title": "Alert Triage and Analyst Decision",
      "description": "Score severity, identify likely false positives, classify an alert, and require an analyst disposition.",
      "fields": [
        {"key": "alertId", "label": "Alert ID", "type": "text", "required": true},
        {"key": "triageMode", "label": "Triage Mode", "type": "select", "required": true, "options": ["Local rules", "Manual assessment", "Configured AI provider"]},
        {"key": "severityThreshold", "label": "Escalation Threshold", "type": "number", "required": true},
        {"key": "analyst", "label": "Reviewing Analyst", "type": "text", "required": true},
        {"key": "initialContext", "label": "Initial Context", "type": "textarea", "required": true}
      ],
      "states": ["queued", "running", "recommendation-ready", "analyst-review", "accepted", "rejected"],
      "transitions": [
        {"id": "run", "label": "Run Triage", "from": ["queued"], "to": "running"},
        {"id": "recommend", "label": "Create Recommendation", "from": ["running"], "to": "recommendation-ready"},
        {"id": "review", "label": "Start Analyst Review", "from": ["recommendation-ready"], "to": "analyst-review"},
        {"id": "accept", "label": "Accept Recommendation", "from": ["analyst-review"], "to": "accepted"},
        {"id": "reject", "label": "Override Recommendation", "from": ["analyst-review"], "to": "rejected"}
      ],
      "seeds": [{"id": "triage-run-1001", "state": "queued", "alertId": "SEC-ALT-1001", "triageMode": "Local rules", "severityThreshold": 70, "analyst": "Mina Shah", "initialContext": "Repeated failed logins followed by a successful privileged session."}]
    },
    {
      "id": "incident-timeline",
      "title": "Incident Timeline",
      "description": "Build and verify an incident chronology from alerts, comments, evidence, enrichment, and response steps.",
      "fields": [
        {"key": "incidentId", "label": "Incident ID", "type": "text", "required": true},
        {"key": "eventDate", "label": "Event Date", "type": "date", "required": true},
        {"key": "eventType", "label": "Event Type", "type": "select", "required": true, "options": ["Alert", "Comment", "Evidence", "Enrichment", "Remediation"]},
        {"key": "summary", "label": "Event Summary", "type": "textarea", "required": true},
        {"key": "evidenceReference", "label": "Evidence Reference", "type": "text", "required": true}
      ],
      "states": ["draft", "recorded", "verified", "corrected"],
      "transitions": [
        {"id": "record", "label": "Record Event", "from": ["draft", "corrected"], "to": "recorded"},
        {"id": "verify", "label": "Verify Event", "from": ["recorded"], "to": "verified"},
        {"id": "correct", "label": "Request Correction", "from": ["recorded", "verified"], "to": "corrected"}
      ],
      "seeds": [{"id": "timeline-event-1001", "state": "draft", "incidentId": "INC-2026-041", "eventDate": "2026-07-13", "eventType": "Alert", "summary": "Privileged login alert normalized from the local SOC fixture.", "evidenceReference": "EVD-INC041-01"}]
    },
    {
      "id": "threat-enrichment",
      "title": "Threat Indicator Enrichment",
      "description": "Enrich an indicator from local test intelligence, manual research, or a clearly configured provider.",
      "fields": [
        {"key": "indicator", "label": "Indicator", "type": "text", "required": true},
        {"key": "indicatorType", "label": "Indicator Type", "type": "select", "required": true, "options": ["IP", "Domain", "Hash", "User", "Host"]},
        {"key": "provider", "label": "Enrichment Provider", "type": "select", "required": true, "options": ["Local test intelligence", "Manual research", "Configured provider"]},
        {"key": "analyst", "label": "Analyst", "type": "text", "required": true},
        {"key": "scope", "label": "Enrichment Scope", "type": "select", "required": true, "options": ["Reputation", "MITRE mapping", "Related indicators", "Full"]}
      ],
      "states": ["queued", "enriching", "results-ready", "reviewed", "failed"],
      "transitions": [
        {"id": "enrich", "label": "Run Enrichment", "from": ["queued", "failed"], "to": "enriching"},
        {"id": "results", "label": "Save Results", "from": ["enriching"], "to": "results-ready"},
        {"id": "review", "label": "Approve Enrichment", "from": ["results-ready"], "to": "reviewed"},
        {"id": "fail", "label": "Record Provider Failure", "from": ["enriching"], "to": "failed"}
      ],
      "seeds": [{"id": "enrichment-1001", "state": "queued", "indicator": "203.0.113.42", "indicatorType": "IP", "provider": "Local test intelligence", "analyst": "Noah Wilson", "scope": "Full"}]
    },
    {
      "id": "remediation-playbooks",
      "title": "Remediation Playbook Run",
      "description": "Prepare approved response steps with rollback notes and validation checks before local execution tracking.",
      "fields": [
        {"key": "playbookName", "label": "Playbook Name", "type": "text", "required": true},
        {"key": "incidentId", "label": "Incident ID", "type": "text", "required": true},
        {"key": "approvalOwner", "label": "Approval Owner", "type": "text", "required": true},
        {"key": "rollbackNotes", "label": "Rollback Notes", "type": "textarea", "required": true},
        {"key": "validationCheck", "label": "Validation Check", "type": "textarea", "required": true}
      ],
      "states": ["draft", "pending-approval", "approved", "running", "validated", "rolled-back"],
      "transitions": [
        {"id": "submit", "label": "Request Approval", "from": ["draft"], "to": "pending-approval"},
        {"id": "approve", "label": "Approve Playbook", "from": ["pending-approval"], "to": "approved"},
        {"id": "run", "label": "Start Run", "from": ["approved"], "to": "running"},
        {"id": "validate", "label": "Validate Outcome", "from": ["running"], "to": "validated"},
        {"id": "rollback", "label": "Record Rollback", "from": ["running", "validated"], "to": "rolled-back"}
      ],
      "seeds": [{"id": "playbook-run-1001", "state": "draft", "playbookName": "Disable suspected privileged session", "incidentId": "INC-2026-041", "approvalOwner": "Security Duty Manager", "rollbackNotes": "Re-enable only after identity verification and credential rotation.", "validationCheck": "Confirm active sessions are revoked and monitoring remains healthy."}]
    },
    {
      "id": "ticket-creation",
      "title": "Incident Ticket Creation and Sync",
      "description": "Create an internal ticket or stage a provider-specific ticket only when that integration is configured.",
      "fields": [
        {"key": "incidentId", "label": "Incident ID", "type": "text", "required": true},
        {"key": "provider", "label": "Ticket Provider", "type": "select", "required": true, "options": ["Internal work queue", "Jira", "ServiceNow", "PagerDuty", "Linear"]},
        {"key": "providerStatus", "label": "Provider Status", "type": "select", "required": true, "options": ["Not required", "Not configured", "Configured"]},
        {"key": "destination", "label": "Project or Queue", "type": "text", "required": true},
        {"key": "ticketSummary", "label": "Ticket Summary", "type": "textarea", "required": true}
      ],
      "states": ["draft", "queued", "created", "sync-pending", "synced", "failed"],
      "transitions": [
        {"id": "queue", "label": "Queue Ticket", "from": ["draft", "failed"], "to": "queued"},
        {"id": "create", "label": "Create Ticket", "from": ["queued"], "to": "created"},
        {"id": "sync", "label": "Request Sync", "from": ["created"], "to": "sync-pending"},
        {"id": "synced", "label": "Record Sync", "from": ["sync-pending"], "to": "synced"},
        {"id": "fail", "label": "Record Failure", "from": ["queued", "sync-pending"], "to": "failed"}
      ],
      "seeds": [{"id": "ticket-job-1001", "state": "draft", "incidentId": "INC-2026-041", "provider": "Internal work queue", "providerStatus": "Not required", "destination": "SOC-L2", "ticketSummary": "Investigate privileged session and complete containment checklist."}]
    },
    {
      "id": "compliance-reporting",
      "title": "Security Compliance Evidence Package",
      "description": "Assemble incident evidence into a reviewable SOC 2, ISO, PCI, or HIPAA security package.",
      "fields": [
        {"key": "framework", "label": "Framework", "type": "select", "required": true, "options": ["SOC 2", "ISO 27001", "PCI DSS", "HIPAA Security"]},
        {"key": "period", "label": "Reporting Period", "type": "text", "required": true},
        {"key": "incidentRefs", "label": "Incident References", "type": "textarea", "required": true},
        {"key": "format", "label": "Package Format", "type": "select", "required": true, "options": ["PDF", "ZIP manifest", "CSV"]},
        {"key": "reviewer", "label": "Compliance Reviewer", "type": "text", "required": true}
      ],
      "states": ["draft", "assembling", "review", "approved", "exported"],
      "transitions": [
        {"id": "assemble", "label": "Assemble Package", "from": ["draft"], "to": "assembling"},
        {"id": "review", "label": "Submit for Review", "from": ["assembling"], "to": "review"},
        {"id": "approve", "label": "Approve Package", "from": ["review"], "to": "approved"},
        {"id": "export", "label": "Export Locally", "from": ["approved"], "to": "exported"}
      ],
      "seeds": [{"id": "compliance-report-1001", "state": "draft", "framework": "SOC 2", "period": "2026 Q2", "incidentRefs": "INC-2026-038, INC-2026-041", "format": "PDF", "reviewer": "Quinn Davis"}]
    },
    {
      "id": "analyst-performance",
      "title": "SOC Analyst Performance Review",
      "description": "Calculate handling time, false positives, escalations, SLA misses, and closure quality for a defined team period.",
      "fields": [
        {"key": "team", "label": "SOC Team", "type": "text", "required": true},
        {"key": "period", "label": "Measurement Period", "type": "text", "required": true},
        {"key": "slaMinutes", "label": "Response SLA Minutes", "type": "number", "required": true},
        {"key": "baselineMode", "label": "Baseline", "type": "select", "required": true, "options": ["Prior period", "Team target", "Custom"]},
        {"key": "reviewOwner", "label": "Review Owner", "type": "text", "required": true}
      ],
      "states": ["configured", "calculating", "manager-review", "published"],
      "transitions": [
        {"id": "calculate", "label": "Calculate Metrics", "from": ["configured"], "to": "calculating"},
        {"id": "review", "label": "Start Manager Review", "from": ["calculating"], "to": "manager-review"},
        {"id": "recalculate", "label": "Recalculate", "from": ["manager-review"], "to": "calculating"},
        {"id": "publish", "label": "Publish Dashboard", "from": ["manager-review"], "to": "published"}
      ],
      "seeds": [{"id": "performance-1001", "state": "configured", "team": "SOC Alpha", "period": "2026-06", "slaMinutes": 30, "baselineMode": "Prior period", "reviewOwner": "SOC Operations Lead"}]
    }
  ],
  "resources": [
    {"name": "alert_sources", "type": "table", "workflowId": "alert-ingestion"},
    {"name": "alert_ingestion_events", "type": "table", "workflowId": "alert-ingestion"},
    {"name": "normalized_alerts", "type": "table", "workflowId": "alert-ingestion"},
    {"name": "ai_triage_runs", "type": "table", "workflowId": "ai-triage"},
    {"name": "triage_findings", "type": "table", "workflowId": "ai-triage"},
    {"name": "triage_recommendations", "type": "table", "workflowId": "ai-triage"},
    {"name": "incident_timeline_events", "type": "table", "workflowId": "incident-timeline"},
    {"name": "incident_evidence", "type": "table", "workflowId": "incident-timeline"},
    {"name": "threat_enrichment_results", "type": "table", "workflowId": "threat-enrichment"},
    {"name": "ioc_reputation", "type": "table", "workflowId": "threat-enrichment"},
    {"name": "mitre_mappings", "type": "table", "workflowId": "threat-enrichment"},
    {"name": "remediation_playbooks", "type": "table", "workflowId": "remediation-playbooks"},
    {"name": "playbook_steps", "type": "table", "workflowId": "remediation-playbooks"},
    {"name": "playbook_runs", "type": "table", "workflowId": "remediation-playbooks"},
    {"name": "ticket_integrations", "type": "table", "workflowId": "ticket-creation"},
    {"name": "ticket_sync_events", "type": "table", "workflowId": "ticket-creation"},
    {"name": "compliance_reports", "type": "table", "workflowId": "compliance-reporting"},
    {"name": "security_evidence_items", "type": "table", "workflowId": "compliance-reporting"},
    {"name": "analyst_performance_metrics", "type": "view", "workflowId": "analyst-performance"},
    {"name": "soc_sla_metrics", "type": "view", "workflowId": "analyst-performance"}
  ]
}
